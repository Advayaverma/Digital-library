# Supabase Configuration Template
# In Vite, variables exposed to client-side code MUST be prefixed with VITE_
# Find these in your Supabase Dashboard: Project Settings -> API -> Project URL & Project API Keys (anon public)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here
